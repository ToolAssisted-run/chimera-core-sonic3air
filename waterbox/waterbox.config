{
  "coreName": "sonic3air",
  "systemNames": {
    "S3AIR": "Sonic 3 A.I.R."
  },
  "systemId": "S3AIR",
  "_system_note": "Sonic 3 - Angel Island Revisited (Sonic 3 A.I.R.), Eukaryot's remaster of Sonic 3 & Knuckles: the Oxygen engine runs the game's logic, rewritten as scripts, against the original ROM, which the project brings as firmware.",
  "kind": "game",
  "author": "Eukaryot (Sonic 3 A.I.R., the Oxygen engine, librmx, lemonscript) and its contributors; Sonic 3 & Knuckles by SEGA and Sonic Team; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-sonic3air",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64",
    "windows-aarch64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's heap (the scripts compiled at power-on, the sprite and audio caches, the files the game writes) on the heap; the ROM (4 MiB), the mods' zips and the remastered soundtrack (about 130 MiB) in sealed memory, read-only after Init and so in no savestate; the C++ library's larger allocations mmap'd. A savestate in play is about 36 MB.",
  "memoryLayoutMiB": [
    512,
    1024,
    4,
    4,
    1024
  ],
  "video": {
    "_comment": "The window upstream's software drawer presents: the game's screen at A.I.R.'s width, 400x224, one pixel a pixel, with the menus drawn over it.",
    "width": 400,
    "height": 224,
    "virtualWidth": 400,
    "virtualHeight": 224,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "rmxmedia's mixer at the engine's rate, run for exactly one sixtieth of a second each step: 800 stereo samples at 48000 Hz (the emulated sound chips, the remastered soundtrack when a project has it, the sound effects).",
    "rate": 48000,
    "samplesPerFrame": 800,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Sonic 3 A.I.R.",
    "_comment": "Two Mega Drive six-button pads. They reach the game as upstream maps its controller onto the pad it emulates: A, B and C jump, Start pauses and confirms in the menus, B goes back; X, Y, Z and Mode are the six-button pad's own (A.I.R. gives some of them actions of its own, see its manual). Player 2 controls Tails in Sonic & Tails, and the second player of Competition.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 A",
      "P1 B",
      "P1 C",
